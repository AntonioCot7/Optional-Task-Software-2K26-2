{
  "components": {
    "schemas": {
      "CustomerInput": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "default": "regular",
            "enum": [
              "regular",
              "premium",
              "business"
            ],
            "title": "Category",
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ],
        "title": "CustomerInput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ItemInput": {
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "exclusiveMinimum": 0.0,
            "title": "Product Id",
            "type": "integer"
          },
          "quantity": {
            "exclusiveMinimum": 0.0,
            "maximum": 10000.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "ItemInput",
        "type": "object"
      },
      "OrderInput": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Address",
            "type": "string"
          },
          "city": {
            "maxLength": 100,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "customer_id": {
            "exclusiveMinimum": 0.0,
            "title": "Customer Id",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemInput"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "postal_code": {
            "maxLength": 20,
            "minLength": 1,
            "title": "Postal Code",
            "type": "string"
          },
          "shipping": {
            "default": "standard",
            "enum": [
              "pickup",
              "standard",
              "express"
            ],
            "title": "Shipping",
            "type": "string"
          }
        },
        "required": [
          "customer_id",
          "address",
          "city",
          "postal_code",
          "items"
        ],
        "title": "OrderInput",
        "type": "object"
      },
      "ProductInput": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "price_cents": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000000.0,
            "title": "Price Cents",
            "type": "integer"
          },
          "stock": {
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Stock",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "price_cents",
          "stock"
        ],
        "title": "ProductInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
